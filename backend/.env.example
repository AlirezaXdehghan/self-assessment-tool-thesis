# Copy to .env, fill in the values, and export them before starting the server.
# Nothing here is loaded automatically - the backend reads these from the
# process environment (see README, "Credentials").

# Mailbox that sends results to candidates
PROTON_USER=
PROTON_PASSWORD=

# Hugging Face access token - required for the gated checkpoints
# (meta-llama/Llama-2-7b-hf, apple/OpenELM-3B-Instruct)
HF_TOKEN=

# Optional
# Where weights and per-exam state are written. Defaults to backend/WorkDir
# WORK_DIRECTORY=
# Which GPU to use. Defaults to 0
# CUDA_VISIBLE_DEVICES=
